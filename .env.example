# Copy to .env and fill in keys. Never commit .env.
# Default chat routing: Gemini primary, Groq fallback on HTTP 429.
# Voice (Whisper / Orpheus) always uses GROQ_API_KEY.

GOOGLE_API_KEY=
# GEMINI_API_KEY=              # accepted as an alias for GOOGLE_API_KEY
GROQ_API_KEY=

# Optional: force a single backend (skips Gemini↔Groq routing)
# LLM_PROVIDER=gemini          # gemini | groq | openai | anthropic
# LLM_MODEL=                   # overrides the primary model only
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_TEMPERATURE=0.3

# Path to the scraped snapshot (defaults to foodpanda-scraper/foodpanda.db)
# FOODPANDA_DB_PATH=foodpanda-scraper/foodpanda.db

# Milestone 5 voice (Groq Whisper + Orpheus). Needs GROQ_API_KEY even if the
# chat LLM is OpenAI or Anthropic. Accept Orpheus English terms in the Groq
# console or TTS will 403.
# TTS_VOICE=troy               # orpheus: troy | hannah | austin | ...

# Milestone 6 API service layer. Tenants, keys and usage live here, separate
# from the scraped snapshot because the daily scrape republishes that file.
# TENANT_DB_PATH=data/tenants.db
# TIERS_CONFIG_PATH=config/tiers.json

# Local demo only: serve static/chat.html with a key baked in, so the page
# works without pasting one. Anyone who can load the page can read the key,
# so leave DEMO_MODE unset anywhere public.
# DEMO_MODE=1
# DEMO_API_KEY=fda_live_...
